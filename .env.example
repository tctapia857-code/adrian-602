# Solo desarrollo local. En Render, DATABASE_URL se asigna desde la base administrada.
NODE_ENV=development
PORT=9090
HOST=0.0.0.0
POSTGRES_USER=inventario
POSTGRES_PASSWORD=inventario_local
POSTGRES_DB=inventario
POSTGRES_PORT=5432
DATABASE_URL=postgresql://inventario:inventario_local@127.0.0.1:5432/inventario
# Opcional localmente; obligatoria en producción. n8n la envía como X-API-Key.
API_KEY=
